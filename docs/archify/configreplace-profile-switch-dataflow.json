      {
        "id": "replace",
        "label": "実行と反映",
        "focus": ["selected-profile", "plan", "profile-source", "copy-engine", "target", "result"],
        "note": "プロファイル内の各フォルダーを順番にコピーし、同じ相対パスを置換します。"
      },
      {
        "id": "safety",
        "label": "安全ガード",
        "focus": ["guards", "profile-source", "copy-engine", "quarantine", "errors"],
        "note": "重なり、再解析ポイント、種類競合、キャンセル時の挙動を追います。"
      }
    ]
  },
  "stages": [
    { "label": "操作" },
    { "label": "対象" },
    { "label": "計画" },
    { "label": "コピー" },
    { "label": "結果" }
  ],
  "nodes": [
    { "id": "user-action", "type": "frontend", "label": "Switch button", "sublabel": "Preview / Switch", "stage": 0, "row": 0, "width": 140, "height": 58 },
    { "id": "vm-command", "type": "backend", "label": "MainViewModel", "sublabel": "command + progress", "stage": 0, "row": 2, "width": 140, "height": 58 },
    { "id": "selected-profile", "type": "database", "label": "SelectedProfile", "sublabel": "Groups / folders", "stage": 1, "row": 1, "width": 140, "height": 58 },
    { "id": "plan", "type": "backend", "label": "CreatePlan", "sublabel": "counts + roots", "stage": 2, "row": 0, "width": 140, "height": 58 },
    { "id": "guards", "type": "security", "label": "Safety guards", "sublabel": "overlap + reparse", "stage": 2, "row": 2, "width": 140, "height": 58 },
    { "id": "profile-source", "type": "database", "label": "Profile folder", "sublabel": "stored source", "stage": 3, "row": 0, "width": 140, "height": 58 },
    { "id": "copy-engine", "type": "backend", "label": "Copy tree", "sublabel": "replace by path", "stage": 3, "row": 2, "width": 140, "height": 58 },
    { "id": "quarantine", "type": "security", "label": "Quarantine", "sublabel": "type conflict", "stage": 3, "row": 1, "width": 140, "height": 58 },
    { "id": "target", "type": "external", "label": "Target folder", "sublabel": "destination", "stage": 4, "row": 1, "width": 140, "height": 58 },
