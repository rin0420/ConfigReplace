  "flows": [
    { "id": "action-command", "from": "user-action", "to": "vm-command", "label": "command", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelAt": [100, 270] },
    { "id": "command-profile", "from": "vm-command", "to": "selected-profile", "label": "profile", "variant": "default" },
    { "id": "profile-plan", "from": "selected-profile", "to": "plan", "label": "metadata", "variant": "emphasis" },
    { "id": "plan-guards", "from": "plan", "to": "guards", "label": "validate", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight", "labelAt": [530, 270] },
    { "id": "guards-source", "from": "guards", "to": "profile-source", "label": "source", "variant": "emphasis" },
    { "id": "source-copy", "from": "profile-source", "to": "copy-engine", "label": "contents", "variant": "emphasis", "fromSide": "right", "toSide": "top", "via": [[840, 157], [840, 330], [745, 330]], "labelAt": [840, 250] },
    { "id": "copy-target", "from": "copy-engine", "to": "target", "label": "replace", "variant": "emphasis", "labelAt": [900, 318] },
