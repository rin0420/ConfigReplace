    { "id": "plan-error", "from": "guards", "to": "errors", "label": "reject", "variant": "security", "fromSide": "bottom", "toSide": "bottom", "route": "bottom-channel", "channelY": 455, "labelAt": [700, 455] },
    { "id": "target-result", "from": "target", "to": "result", "label": "success", "variant": "default", "fromSide": "top", "toSide": "bottom", "route": "straight" },
    { "id": "copy-error", "from": "copy-engine", "to": "errors", "label": "partial", "variant": "security", "fromSide": "right", "toSide": "left", "labelAt": [850, 430] },
    { "id": "error-result", "from": "errors", "to": "result", "label": "failure", "variant": "security", "fromSide": "right", "toSide": "right", "route": "vertical-channel", "channelX": 1055, "labelAt": [1055, 385] }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "計画と実行の境界",
      "items": [
        "MainViewModel.cs:351-430 — PreviewSwitchAsync は CreatePlan、SwitchAsync は同計画の ExecuteAsync を呼びます。",
        "ProfileFolderSetSwitchService.cs:13-172 — 配置先ごとに計画を検証し、各フォルダーを順番に処理します。"
      ]
    },
    {
      "dot": "emerald",
      "title": "データとコピーの意味",
      "items": [
        "ProfileStore.cs:91-102 — ソースは Profiles\\<profile>\\<folder> の直接配置形式です。",
        "FolderTreeService.cs:5-240, 321-455 — 同相対パスを一時ファイル経由で置換し、種類競合は退避・復旧します。"
      ]
    },
    {
      "dot": "rose",
      "title": "検証と部分反映",
      "items": [
        "ProfileFolderSetSwitchService.cs:174-229 — Profiles との重なり、再解析ポイント、対象の安全性を拒否します。",
        "MainViewModel.cs:394-430 — キャンセル/I/O 失敗を通知します。全体 Rollback はなく、完了済みフォルダーは残ります。"
      ]
    }
  ]
}
